# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# full = desarrollo/preview completo; presentation = demo Vercel sin cobros/reservas
NEXT_PUBLIC_SITE_MODE=full

# ---------------------------------------------------------------------------
# Database — Prisma + PostgreSQL
# ---------------------------------------------------------------------------
# LOCAL (default): Docker compose puerto 5434 — MISMA URL en ambas variables.
DATABASE_URL=postgresql://serbrujula:serbrujula@localhost:5434/ser_brujula?schema=public
DIRECT_URL=postgresql://serbrujula:serbrujula@localhost:5434/ser_brujula?schema=public
#
# SUPABASE (no versionar passwords; no reemplazar el bloque LOCAL del día a día):
#   Presentation ref cfomrtrkhytmlwjwmfes | Preview ref mhzijxwfvissdfgllwsk | región us-east-2
#   DATABASE_URL = Transaction pooler :6543 + ?pgbouncer=true&sslmode=require
#   DIRECT_URL   = Session pooler :5432 + ?sslmode=require
#   Usuario pooler: postgres.<project-ref>
#   Host típico: aws-1-us-east-2.pooler.supabase.com
# Detalle: docs/INTEGRATIONS.md § Supabase PostgreSQL

# Auth.js (NO Supabase Auth)
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string

# Seed admin (prisma/seed.ts) — OBLIGATORIOS; sin defaults de password.
# Generá un password ≥12 chars distinto por entorno. No uses ChangeMeAdmin123!.
SEED_ADMIN_EMAIL=admin@serbrujula.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administradora

# Business
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# Mercado Pago (si ACCESS_TOKEN está vacío → modo MANUAL de desarrollo/E2E)
# Con token activo, WEBHOOK_SECRET es obligatorio (Secret signature del panel, modo Test/Prod).
# NEXT_PUBLIC_APP_URL debe ser HTTPS público (ngrok en local) para back_urls + notification_url.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Solo para modo MANUAL (dev/E2E). Cambiar en cada entorno.
MANUAL_PAYMENT_SECRET=dev-manual-secret

# Resend
RESEND_API_KEY=
EMAIL_FROM="Ser Brújula <noreply@example.com>"
EMAIL_ADMIN_TO=admin@example.com

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Google Calendar (etapa 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
# Mín. 16 caracteres; cifra tokens OAuth en DB
TOKEN_ENCRYPTION_KEY=change-me-token-encryption-key
