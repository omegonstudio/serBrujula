# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (docker compose: postgres on 5434)
DATABASE_URL=postgresql://serbrujula:serbrujula@localhost:5434/ser_brujula?schema=public

# Auth.js
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string

# Seed admin (used by prisma/seed.ts) — change in production
SEED_ADMIN_EMAIL=admin@serbrujula.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=Administradora

# Business
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# Mercado Pago (si está vacío, checkout usa modo MANUAL de desarrollo)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Solo para modo MANUAL (dev/E2E). Cambiar en cada entorno.
MANUAL_PAYMENT_SECRET=dev-manual-secret

# Resend
RESEND_API_KEY=
EMAIL_FROM="Ser Brújula <noreply@example.com>"
EMAIL_ADMIN_TO=admin@example.com

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Google Calendar (etapa 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
# Mín. 16 caracteres; cifra tokens OAuth en DB
TOKEN_ENCRYPTION_KEY=change-me-token-encryption-key
